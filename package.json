{
  "name": "p-camera-h5",
  "version": "3.0.0-beta.1",
  "description": "轻量级 H5 相机插件，支持拍照、录像、文字与图片水印",
  "main": "./lib/p-camera-h5.es.js",
  "browser": "./lib/p-camera-h5.umd.js",
  "unpkg": "./lib/p-camera-h5.umd.js",
  "type": "module",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/p-camera-h5.es.js",
      "require": "./lib/p-camera-h5.umd.js"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rollup -c",
    "dev": "cross-env NODE_ENV=dev rollup -c -w"
  },
  "bugs": {
    "url": "https://github.com/pbstar/p-camera-h5/issues"
  },
  "contributors": [
    {
      "name": "彭勃",
      "email": "pbstar@sina.cn"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pbstar/p-camera-h5.git"
  },
  "homepage": "https://github.com/pbstar/p-camera-h5",
  "keywords": [
    "camera",
    "camera-h5",
    "webcam",
    "getUserMedia",
    "MediaRecorder",
    "watermark",
    "capture",
    "record",
    "video",
    "mobile"
  ],
  "author": "pengbo <pbstar@sina.cn>",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^20.14.10",
    "cross-env": "^7.0.3",
    "rollup": "^4.17.2",
    "rollup-plugin-serve": "^1.1.1",
    "tslib": "^2.6.3",
    "typescript": "^5.9.3"
  }
}
