{
  "compilerOptions": {
    "target": "ESNext", // 编译目标
    "module": "ESNext", // 模块系统
    "noEmit": true, // 不生成编译后的文件
    "moduleResolution": "bundler", // 模块解析器
    "strict": true, // 严格模式
    "lib": ["ESNext", "DOM"], // 引入 DOM 类型
    "resolveJsonModule": true // 允许导入 `.json` 文件
  },
  "include": ["src/**/*"], // 包含哪些文件
  "exclude": ["node_modules"] // 排除哪些文件
}
